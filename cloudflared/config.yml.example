# Named Cloudflare Tunnel — copy to config.yml and fill in values.
# Prefer storing the real config as %USERPROFILE%\.cloudflared\config.yml (see docs).
#
# After: cloudflared tunnel create neraium-local
#   - Note the tunnel UUID printed.
#   - Credentials file is created next to your profile, e.g.:
#     C:\Users\<you>\.cloudflared\<UUID>.json
#
# Replace:
#   <TUNNEL_UUID>     — from `cloudflared tunnel list` or tunnel create output
#   <CREDENTIALS_JSON> — full path to the .json file for this tunnel
#   <PUBLIC_HOSTNAME> — hostname you routed (e.g. neraium.yourdomain.com)

tunnel: <TUNNEL_UUID>
credentials-file: <CREDENTIALS_JSON>

ingress:
  - hostname: <PUBLIC_HOSTNAME>
    service: http://127.0.0.1:7860
  # Catch-all required by cloudflared:
  - service: http_status:404
