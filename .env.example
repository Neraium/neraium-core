# Core runtime
NERAIUM_API_KEY=change-me
NERAIUM_DB_PATH=/data/neraium.db
HOST=0.0.0.0
PORT=8000
NERAIUM_LOG_LEVEL=INFO
NERAIUM_RUNTIME_MODE=development
NERAIUM_BASELINE_WINDOW=24
NERAIUM_RECENT_WINDOW=8
NERAIUM_INPUT_PATH=
NERAIUM_DATA_PATH=
NERAIUM_REQUIRE_INPUT_PATH=0
NERAIUM_REQUIRE_DATA_PATH=0

# Optional: default customer context for health checks and integrations
NERAIUM_DEFAULT_CUSTOMER_ID=default-customer

# Customer API integration defaults (used by /integrations/pull/start when fields omitted)
NERAIUM_CUSTOMER_API_BASE_URL=https://customer-api.internal/telemetry
NERAIUM_CUSTOMER_API_AUTH_TYPE=none
NERAIUM_CUSTOMER_API_TOKEN=
NERAIUM_CUSTOMER_API_USERNAME=
NERAIUM_CUSTOMER_API_PASSWORD=
NERAIUM_CUSTOMER_API_POLL_INTERVAL_SECONDS=30
NERAIUM_CUSTOMER_API_RETRY_MAX_ATTEMPTS=3
NERAIUM_CUSTOMER_API_RETRY_BACKOFF_SECONDS=1.0
NERAIUM_CUSTOMER_API_TIMEOUT_SECONDS=10.0

# Optional compatibility aliases (legacy names still accepted)
NERAIUM_DEFAULT_CUSTOMER_API_BASE_URL=
NERAIUM_DEFAULT_CUSTOMER_API_AUTH_TYPE=
NERAIUM_DEFAULT_CUSTOMER_API_TOKEN=
NERAIUM_DEFAULT_CUSTOMER_API_USERNAME=
NERAIUM_DEFAULT_CUSTOMER_API_PASSWORD=
NERAIUM_PULL_POLLING_INTERVAL_SECONDS=
NERAIUM_PULL_RETRY_MAX_ATTEMPTS=
NERAIUM_PULL_RETRY_BACKOFF_SECONDS=
NERAIUM_PULL_REQUEST_TIMEOUT_SECONDS=

# Config-driven customer payload mapping
NERAIUM_INTEGRATION_CONFIG_PATH=/config/integration.json

# Minimal alerts
# Trigger when composite_instability crosses threshold from below.
NERAIUM_ALERT_INSTABILITY_THRESHOLD=1.5
# Trigger when structural_drift_score jumps by at least this delta vs previous result.
NERAIUM_ALERT_RAPID_DRIFT_DELTA=0.2
# Optional notification stubs (logs only in this minimal version)
NERAIUM_ALERT_WEBHOOK_URL=
NERAIUM_ALERT_EMAIL_TO=

# Request/body limits
NERAIUM_MAX_REQUEST_BODY_BYTES=52428800
NERAIUM_UVICORN_H11_MAX_INCOMPLETE_EVENT_SIZE=62914560

# Optional: pilot hardening controls
NERAIUM_PILOT_HARDENING=0
NERAIUM_DEBUG_PILOT=0
NERAIUM_PILOT_CONFIG_PATH=
NERAIUM_PILOT_DRIFT_HIGH_THRESHOLD=
NERAIUM_PILOT_DRIFT_WATCH_THRESHOLD=

# GAL-2 time API (optional, non-production demos/tests only)
GAL2_API_KEY=
GAL2_TIME_URL=https://api-v2.gal-2.com/time
