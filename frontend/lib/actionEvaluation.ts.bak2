/**
 * Generate candidate actions based on failure mode and current state.
 */
export function generateCandidateActions(
  failureMode: string,
  phase: string
): ActionCandidate[] {
  const candidates = actionCandidatesByFailureMode[failureMode] || actionCandidatesByFailureMode['multi-mode']

  // If in Stable or Drift forming, include conservative options
  if (phase === 'Stable' || phase === 'Drift forming') {
    return candidates.filter(a => a.aggressiveness < 0.6)
  }

  // In Instability+, include more aggressive options
  return candidates
}

/**
 * Score a single action candidate based on system state.
 * Weighted formula across 6 dimensions.
 */
export function scoreCandidateAction(
  action: ActionCandidate,
  failureMode: string,
  drift: number,
  stability: number,
  coherence: number,
  phase: string,
  timeToImpact: number | null,
  confidence: 'high' | 'moderate' | 'low'
): ScoredAction {
  // Stabilization benefit: how well does this action address the current state?
  let stabilizationBenefit = 0
  if (failureMode === 'drift-driven' && action.failureModeFit.includes('drift-driven')) {
    stabilizationBenefit = Math.max(0.5, 1 - drift) // Better if drift is high
  } else if (failureMode === 'stability-critical' && action.failureModeFit.includes('stability-critical')) {
    stabilizationBenefit = Math.max(0.5, 1 - stability)
  } else if (failureMode === 'coherence-loss' && action.failureModeFit.includes('coherence-loss')) {
    stabilizationBenefit = Math.max(0.5, 1 - coherence)
  } else if (action.failureModeFit.includes(failureMode)) {
    stabilizationBenefit = 0.7
  } else {
    stabilizationBenefit = 0.3
  }

  // Structural risk reduction: does this action reduce immediate danger?
  let riskReduction = 0
  if (stability < 0.3 && action.aggressiveness > 0.6) {
    riskReduction = 0.8 // Aggressive action helps when stability is critical
  } else if (coherence < 0.35 && action.aggressiveness > 0.7) {
    riskReduction = 0.8
  } else if (drift > 0.75 && action.aggressiveness > 0.4) {
    riskReduction = 0.7
  } else {
    riskReduction = 0.4 + action.aggressiveness * 0.3
  }

  // Failure mode compatibility
  const failureModeFit = action.failureModeFit.includes(failureMode) ? 1.0 : 0.5

  // Time sensitivity fit: does urgency match action intensity?
  let timeSensitivityFit = 0.5
  if (timeToImpact !== null) {
    if (timeToImpact < 3000 && action.aggressiveness > 0.6) {
      timeSensitivityFit = 0.95 // Critical window + aggressive action
    } else if (timeToImpact < 5000 && action.aggressiveness > 0.5) {
      timeSensitivityFit = 0.85
    } else if (timeToImpact > 10000 && action.aggressiveness < 0.4) {
      timeSensitivityFit = 0.85 // Non-urgent + conservative action
    }
  }

  // Confidence alignment: higher confidence allows more decisive actions
  const confidenceBoost = confidence === 'high' ? 0.95 : confidence === 'moderate' ? 0.75 : 0.5

  // Aggressiveness penalty: avoid over-intervention in stable states
  let aggressivenessPenalty = 1.0
  if (phase === 'Stable' || phase === 'Drift forming') {
    aggressivenessPenalty = Math.max(0.4, 1.0 - action.aggressiveness * 1.5)
  }

  // Weighted formula: emphasize stabilization benefit and risk reduction
  const score =
    stabilizationBenefit * 0.35 +
    riskReduction * 0.25 +
    failureModeFit * 0.20 +
    timeSensitivityFit * 0.12 +
    (confidenceBoost * 0.08) * (confidenceBoost / 0.95) // Scale by confidence
  const finalScore = score * aggressivenessPenalty

  return {
    label: action.label,
    score: finalScore,
    stabilizationBenefit,
    riskReduction,
    failureModeFit,
    timeSensitivityFit,
    confidence: confidenceBoost,
    aggressivenessPenalty,
  }
}

/**
 * Rank actions by score (descending).
 */
export function rankCandidateActions(actions: ScoredAction[]): ScoredAction[] {
  return [...actions].sort((a, b) => b.score - a.score)
}

