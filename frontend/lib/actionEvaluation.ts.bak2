/**
 * Compute timing sensitivity based on time-to-impact and action intensity.
 */
export function computeTimingSensitivity(
  timeToImpact: number | null,
  phase: string,
  drift: number,
  stability: number,
  driftAcceleration: number
): string {
  // Critical urgency: imminent failure window
  if (timeToImpact !== null && timeToImpact < 3000) {
    return 'Action timing critical'
  }

  // High urgency: narrowing window
  if (timeToImpact !== null && timeToImpact < 8000) {
    return 'Delay reduces effectiveness'
  }

  // Moderate urgency: drift accelerating
  if (driftAcceleration > 0.1 && phase === 'Instability forming') {
    return 'Intervention window open'
  }

  // Escalating: entering critical phase
  if (phase === 'Critical') {
    return 'Immediate action preferred'
  }

  // Window available: Drift forming or early instability
  if (phase === 'Instability forming' && timeToImpact !== null && timeToImpact > 8000) {
    return 'Action window still open'
  }

  // Stable or low pressure
  return 'Monitor for changes'
}

/**
 * Track recommendation stability over rolling action history.
 * Returns 'high', 'moderate', or 'unstable'.
 */
export function computeRecommendationStability(
  currentTopAction: string,
  previousRankedActions: RankedAction[],
  hysteresisThreshold: number = 0.15 // 15% margin required to switch
): 'high' | 'moderate' | 'unstable' {
  // Not enough history
  if (previousRankedActions.length === 0) {
    return 'moderate'
  }

  const previousTopAction = previousRankedActions[0]

  // Same action recommended
  if (currentTopAction === previousTopAction.label) {
    return 'high'
  }

  // Check if margin is large enough to justify switch
  const currentScore = 0.8 // Placeholder; would come from scoring
  const previousScore = previousTopAction.score
  const marginRatio = (currentScore - previousScore) / previousScore

  // Large margin = justified switch (stable)
  if (marginRatio > hysteresisThreshold) {
    return 'moderate'
  }

  // Small margin = unstable recommendation
  return 'unstable'
}

/**
 * Evaluate all candidate actions and return ranked decision result.
 */
export function evaluateActionDecision(
  phase: string,
  failureMode: string,
  drift: number,
  stability: number,
  coherence: number,
  confidence: 'high' | 'moderate' | 'low',
  timeToImpact: number | null,
  driftAcceleration: number,
  noActionConsequence: string | null,
  previousRankedActions: RankedAction[] = []
): ActionDecisionResult {
  // Generate candidates based on failure mode
  const candidates = generateCandidateActions(failureMode, phase)

  // Score each candidate
  const scored = candidates.map(action =>
    scoreCandidateAction(
      action,
      failureMode,
      drift,
      stability,
      coherence,
      phase,
      timeToImpact,
      confidence
    )
  )

  // Rank by score
  const ranked = rankCandidateActions(scored)

  // Project outcomes for top actions
  const rankedWithOutcomes: RankedAction[] = ranked.map(action => ({
    ...action,
    outcome: projectActionOutcome(
      action.label,
      failureMode,
      drift,
      stability,
      coherence,
      confidence
    ),
    timingSensitivity: computeTimingSensitivity(
      timeToImpact,
      phase,
      drift,
      stability,
      driftAcceleration
    ),
  }))

  // Get top action and alternatives
  const primaryAction = rankedWithOutcomes[0]
  const alternatives = rankedWithOutcomes.slice(1, 3) // Up to 2 alternatives

  // Compute stability
  const stability_rec = computeRecommendationStability(
    (primaryAction?.label ?? "No recommendation"),
    previousRankedActions
  )

  // Decision summary: brief narrative
  const decisionSummary =
    phase === 'Critical'
      ? 'Critical phase: immediate intervention required'
      : phase === 'Instability forming'
        ? 'Instability detected: intervention advisable'
        : 'Drift forming: monitoring ongoing'

  return {
    primaryAction: {
      label: (primaryAction?.label ?? "No recommendation"),
      confidence,
      outcome: (primaryAction?.outcome ?? null),
      timingSensitivity: (primaryAction?.timingSensitivity ?? null),
      score: primaryAction.score,
      stabilizationBenefit: primaryAction.stabilizationBenefit,
    },
    alternatives: alternatives.map(a => ({
      label: a.label,
      confidence,
      outcome: a.outcome,
      timingSensitivity: a.timingSensitivity,
      score: a.score,
    })),
    noActionConsequence,
    recommendationStability: stability_rec,
    decisionSummary,
  }
}
