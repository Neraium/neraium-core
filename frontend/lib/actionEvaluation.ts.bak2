/**
 * Action Evaluation System
 *
 * Lightweight multi-action decision engine inspired by AlphaZero-style evaluation.
 * Generates candidate actions, ranks them by weighted scoring, tracks recommendation stability.
 * No ML, no tree search, deterministic logic only.
 */

export interface ActionCandidate {
  label: string
  description: string
  failureModeFit: string[] // Which failure modes this action addresses
  aggressiveness: number // 0-1, intervention intensity
}

export interface ScoredAction {
  label: string
  score: number
  stabilizationBenefit: number
  riskReduction: number
  failureModeFit: number
  timeSensitivityFit: number
  confidence: number
  aggressivenessPenalty: number
}

export interface ProjectedOutcome {
  primary: string // Main outcome, max 5 words
  continuation?: string // Optional second step
}

export interface RankedAction extends ScoredAction {
  outcome: ProjectedOutcome
  timingSensitivity: string
}

export interface ActionDecisionResult {
  primaryAction: {
    label: string
    confidence: 'high' | 'moderate' | 'low'
    outcome: ProjectedOutcome
    timingSensitivity: string
    score: number
    stabilizationBenefit: number
  }
  alternatives: {
    label: string
    confidence: 'high' | 'moderate' | 'low'
    outcome: ProjectedOutcome
    timingSensitivity: string
    score: number
  }[]
  noActionConsequence: string | null
  recommendationStability: 'high' | 'moderate' | 'unstable'
  decisionSummary: string
}

