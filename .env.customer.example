NERAIUM_API_KEY=replace-with-strong-key
NERAIUM_DB_PATH=/data/neraium.db
NERAIUM_RUNTIME_MODE=production
HOST=0.0.0.0
PORT=8000
NERAIUM_LOG_LEVEL=INFO

# Optional: default customer context
NERAIUM_DEFAULT_CUSTOMER_ID=default-customer

# Customer API defaults for pull integration
NERAIUM_CUSTOMER_API_BASE_URL=https://customer-api.internal/telemetry
NERAIUM_CUSTOMER_API_AUTH_TYPE=bearer
NERAIUM_CUSTOMER_API_TOKEN=replace-with-customer-token
NERAIUM_CUSTOMER_API_USERNAME=
NERAIUM_CUSTOMER_API_PASSWORD=
NERAIUM_CUSTOMER_API_POLL_INTERVAL_SECONDS=30
NERAIUM_CUSTOMER_API_RETRY_MAX_ATTEMPTS=3
NERAIUM_CUSTOMER_API_RETRY_BACKOFF_SECONDS=1.0
NERAIUM_CUSTOMER_API_TIMEOUT_SECONDS=10.0

# Optional pull aliases (kept for compatibility)
NERAIUM_PULL_POLLING_INTERVAL_SECONDS=30
NERAIUM_PULL_RETRY_MAX_ATTEMPTS=3
NERAIUM_PULL_RETRY_BACKOFF_SECONDS=1.0
NERAIUM_PULL_REQUEST_TIMEOUT_SECONDS=10.0

# Mapping config location inside container
NERAIUM_INTEGRATION_CONFIG_PATH=/config/integration.json

# Minimal alerting (optional)
NERAIUM_ALERT_INSTABILITY_THRESHOLD=1.5
NERAIUM_ALERT_RAPID_DRIFT_DELTA=0.2
# Optional stubs for delivery hooks (logs only)
# NERAIUM_ALERT_WEBHOOK_URL=https://example.internal/neraium-alerts
# NERAIUM_ALERT_EMAIL_TO=ops@example.com

# Upload and parser limits
NERAIUM_MAX_REQUEST_BODY_BYTES=52428800
NERAIUM_UVICORN_H11_MAX_INCOMPLETE_EVENT_SIZE=62914560

# Optional pilot controls
NERAIUM_PILOT_HARDENING=0
NERAIUM_DEBUG_PILOT=0
