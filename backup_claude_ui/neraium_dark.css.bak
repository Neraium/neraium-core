:root {
  --bg-void: #020309;
  --bg-deep: #060914;
  --bg-nebula: #131330;
  --text: #d2ddff;
  --chrome: rgba(176, 196, 255, 0.16);
  --motion-cool: #72d8ff;
  --motion-transition: #8d7dff;
  --motion-warm: #ff9b7d;
  --stability: #79d5ff;
  --divergence: #ff8c74;
}

body {
  background:
    radial-gradient(circle at 14% 18%, rgba(71, 96, 197, 0.2) 0%, rgba(71, 96, 197, 0) 38%),
    radial-gradient(circle at 74% 78%, rgba(130, 77, 188, 0.14) 0%, rgba(130, 77, 188, 0) 46%),
    linear-gradient(160deg, var(--bg-deep), var(--bg-void) 72%);
  color: var(--text);
  font-family: Inter, system-ui, sans-serif;
}

.gradio-container {
  max-width: 1240px !important;
  background: transparent !important;
}

.block,
.panel,
.gr-box,
.gr-form,
.gr-group {
  border: 0 !important;
  box-shadow: none !important;
  background: rgba(7, 9, 18, 0.28) !important;
}

.neraium-surface {
  background: linear-gradient(140deg, rgba(114, 216, 255, 0.065), rgba(141, 125, 255, 0.05), rgba(255, 155, 125, 0.05));
  border: 1px solid rgba(146, 164, 255, 0.1);
  border-radius: 18px;
  padding: 16px;
  backdrop-filter: blur(6px);
  box-shadow: inset 0 0 48px rgba(97, 129, 255, 0.06), 0 0 36px rgba(75, 98, 194, 0.14);
}

.gr-button,
.gr-input {
  border-color: var(--chrome) !important;
}
